'use client';

import React from 'react';
import { useQuery } from '@tanstack/react-query';
import { create } from 'zustand';
import { LineChart, Line, XAxis, YAxis, Tooltip, ResponsiveContainer } from 'recharts';
import { TrendingUp, Sparkles, DollarSign, ShoppingCart, Activity } from 'lucide-react';

// --- Types ---
interface MetricData {
  time: string;
  revenue: number;
  orders: number;
}

interface DashboardState {
  timeframe: '24h' | '7d' | '30d';
  setTimeframe: (tf: '24h' | '7d' | '30d') => void;
}

// --- Zustand State Management ---
export const useDashboardStore = create<DashboardState>((set) => ({
  timeframe: '7d',
  setTimeframe: (timeframe) => set({ timeframe }),
}));

// --- Mock API Fetcher (Replace with real API) ---
const fetchDashboardData = async (timeframe: string) => {
  const res = await fetch(`/api/analytics?timeframe=${timeframe}`);
  if (!res.ok) throw new Error('Failed to fetch analytics data');
  return res.json();
};

export default function AnalyticsDashboard() {
  const { timeframe, setTimeframe } = useDashboardStore();

  // React Query Caching & Data Fetching
  const { data, isLoading } = useQuery({
    queryKey: ['analytics', timeframe],
    queryFn: () => fetchDashboardData(timeframe),
    staleTime: 1000 * 60 * 5, // 5 mins cache
  });

  return (
    <div className="w-full max-w-7xl mx-auto p-4 md:p-6 space-y-6 bg-gray-50 dark:bg-gray-950 text-gray-900 dark:text-gray-100 rounded-2xl border border-gray-200 dark:border-gray-800 transition-colors">
      
      {/* Header & Controls */}
      <div className="flex flex-col sm:flex-row sm:items-center sm:justify-between gap-4">
        <div>
          <h1 className="text-2xl font-bold tracking-tight">Nexus Analytics</h1>
          <p className="text-sm text-gray-500 dark:text-gray-400">Real-time e-commerce performance & AI insights</p>
        </div>
        
        <div className="flex items-center gap-2 bg-gray-200 dark:bg-gray-800 p-1 rounded-xl w-fit">
          {(['24h', '7d', '30d'] as const).map((tf) => (
            <button
              key={tf}
              onClick={() => setTimeframe(tf)}
              className={`px-3 py-1.5 text-xs font-semibold rounded-lg transition-all ${
                timeframe === tf
                  ? 'bg-white dark:bg-gray-900 text-indigo-600 dark:text-indigo-400 shadow-sm'
                  : 'text-gray-600 dark:text-gray-400 hover:text-gray-900 dark:hover:text-gray-100'
              }`}
            >
              {tf.toUpperCase()}
            </button>
          ))}
        </div>
      </div>

      {/* OpenAI Insights Banner */}
      <div className="relative overflow-hidden p-4 rounded-xl bg-gradient-to-r from-indigo-500/10 via-purple-500/10 to-pink-500/10 border border-indigo-500/20 dark:border-indigo-500/30">
        <div className="flex items-start gap-3">
          <div className="p-2 bg-indigo-600 text-white rounded-lg shadow-md shrink-0">
            <Sparkles className="w-5 h-5 animate-pulse" />
          </div>
          <div>
            <h2 className="text-sm font-semibold text-indigo-900 dark:text-indigo-300">OpenAI Business Insight</h2>
            <p className="text-xs text-gray-700 dark:text-gray-300 mt-1 leading-relaxed">
              Revenue surged by <span className="font-bold text-emerald-600 dark:text-emerald-400">+14.2%</span> compared to last period. Conversion rate peaks around 18:00–21:00 UTC. Consider boosting retargeting ads during evening hours.
            </p>
          </div>
        </div>
      </div>

      {/* KPI Cards Grid */}
      <div className="grid grid-cols-1 sm:grid-cols-3 gap-4">
        <MetricCard title="Total Revenue" value="$48,290.00" change="+12.5%" icon={<DollarSign className="w-5 h-5 text-emerald-500" />} />
        <MetricCard title="Orders" value="1,240" change="+8.1%" icon={<ShoppingCart className="w-5 h-5 text-indigo-500" />} />
        <MetricCard title="Conversion Rate" value="3.42%" change="-0.4%" isNegative icon={<Activity className="w-5 h-5 text-purple-500" />} />
      </div>

      {/* Recharts Analytics Chart */}
      <div className="p-5 bg-white dark:bg-gray-900 rounded-xl border border-gray-200 dark:border-gray-800 shadow-sm">
        <div className="flex items-center justify-between mb-4">
          <h2 className="text-base font-semibold">Revenue Trend</h2>
          <TrendingUp className="w-5 h-5 text-gray-400" />
        </div>
        <div className="h-64 w-full">
          <ResponsiveContainer width="100%" height="100%">
            <LineChart data={mockData}>
              <XAxis dataKey="time" stroke="#888888" fontSize={12} tickLine={false} axisLine={false} />
              <YAxis stroke="#888888" fontSize={12} tickLine={false} axisLine={false} tickFormatter={(v) => `$${v}`} />
              <Tooltip
                contentStyle={{ backgroundColor: '#18181b', borderRadius: '8px', border: 'none', color: '#fff' }}
              />
              <Line type="monotone" dataKey="revenue" stroke="#6366f1" strokeWidth={3} dot={false} />
            </LineChart>
          </ResponsiveContainer>
        </div>
      </div>

    </div>
  );
}

// --- Sub-components ---
interface MetricCardProps {
  title: string;
  value: string;
  change: string;
  icon: React.ReactNode;
  isNegative?: boolean;
}

function MetricCard({ title, value, change, icon, isNegative }: MetricCardProps) {
  return (
    <div className="p-4 bg-white dark:bg-gray-900 rounded-xl border border-gray-200 dark:border-gray-800 shadow-sm flex items-center justify-between">
      <div>
        <p className="text-xs text-gray-500 dark:text-gray-400 font-medium">{title}</p>
        <p className="text-xl font-bold mt-1">{value}</p>
        <span className={`text-xs font-semibold mt-1 inline-block ${isNegative ? 'text-red-500' : 'text-emerald-500'}`}>
          {change} vs last period
        </span>
      </div>
      <div className="p-3 bg-gray-100 dark:bg-gray-800 rounded-xl">{icon}</div>
    </div>
  );
}

